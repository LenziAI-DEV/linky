[
  {
    "id": "linkyLedgerAlerts",
    "name": "[linky] Alertas do ledger (de hora em hora)",
    "active": false,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "10 * * * *"
              }
            ]
          }
        },
        "name": "A cada hora (min 10)",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          0,
          0
        ],
        "id": "1c92923d-4e35-5f48-9098-e25ba6341ef1"
      },
      {
        "parameters": {},
        "name": "Manual",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [
          0,
          200
        ],
        "id": "211cf506-f244-5b29-9055-0e34660c054e"
      },
      {
        "parameters": {
          "method": "GET",
          "url": "http://linky-agents:8080/alerts",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "options": {}
        },
        "name": "Alertas",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          240,
          100
        ],
        "id": "59e37320-4526-591b-b195-8ef863cf7651",
        "credentials": {
          "httpHeaderAuth": {
            "id": "linkyAgentsToken",
            "name": "linky-agents (X-Linky-Token)"
          }
        }
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "54acc952-0f08-5965-9104-200ad2475574",
                "leftValue": "={{ $json.email != null }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "name": "Tem alerta?",
        "type": "n8n-nodes-base.filter",
        "typeVersion": 2.2,
        "position": [
          480,
          100
        ],
        "id": "208a67e8-cf20-598d-a9a6-0122897b7a40"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://api.resend.com/emails",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ from: 'linky-dev <linky@example.com>', to: ['voce@example.com'], subject: $('Alertas').first().json.email.subject, html: $('Alertas').first().json.email.html, text: $('Alertas').first().json.email.text }) }}",
          "options": {}
        },
        "name": "Enviar e-mail",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          720,
          100
        ],
        "id": "dd429e94-bf12-5756-a0f2-3e3663d70d7b",
        "credentials": {
          "httpHeaderAuth": {
            "id": "RESEND_CREDENTIAL_ID",
            "name": "Resend linky"
          }
        }
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://linky-agents:8080/alerts/ack",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "options": {},
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ ids: $('Alertas').first().json.alerts.map(a => a.id) }) }}"
        },
        "name": "Confirmar",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          960,
          100
        ],
        "id": "13379ae6-e229-5713-98ff-9c57fa6384ce",
        "credentials": {
          "httpHeaderAuth": {
            "id": "linkyAgentsToken",
            "name": "linky-agents (X-Linky-Token)"
          }
        }
      }
    ],
    "connections": {
      "A cada hora (min 10)": {
        "main": [
          [
            {
              "node": "Alertas",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Manual": {
        "main": [
          [
            {
              "node": "Alertas",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Alertas": {
        "main": [
          [
            {
              "node": "Tem alerta?",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Tem alerta?": {
        "main": [
          [
            {
              "node": "Enviar e-mail",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Enviar e-mail": {
        "main": [
          [
            {
              "node": "Confirmar",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1",
      "timezone": "America/Sao_Paulo",
      "saveManualExecutions": true,
      "callerPolicy": "workflowsFromSameOwner"
    }
  }
]
