{
  "version": "1.2.0",
  "canvas": { "width": 1080, "height": 1350, "margin": 72 },
  "colors": {
    "paper": "#F4F1EA",
    "charcoal": "#2D2A33",
    "ink": "#25222B",
    "violet": "#7C4DFF",
    "lavender": "#C8B4FF",
    "lavender_soft": "#E9E1FF",
    "lime": "#D4F25A",
    "white": "#FFFFFF",
    "muted_on_paper": "#6E6A78",
    "rule_on_paper": "#D9D4C8",
    "text_on_violet": "#EDE7FF",
    "text_on_charcoal": "#F3F0FA",
    "muted_on_charcoal": "#A8A2B5",
    "rule_on_charcoal": "#4A4554",
    "halftone_on_charcoal": "#4A4554"
  },
  "fonts": {
    "headline": { "family": "Barlow Condensed", "weight": 800, "file": "BarlowCondensed-ExtraBold.ttf" },
    "headline_alt": { "family": "Barlow Condensed", "weight": 700, "file": "BarlowCondensed-Bold.ttf" },
    "body": { "family": "Barlow", "weight": 400, "file": "Barlow-Regular.ttf" },
    "body_medium": { "family": "Barlow", "weight": 500, "file": "Barlow-Medium.ttf" },
    "body_semibold": { "family": "Barlow", "weight": 600, "file": "Barlow-SemiBold.ttf" },
    "body_bold": { "family": "Barlow", "weight": 700, "file": "Barlow-Bold.ttf" }
  },
  "headline": { "max_size": 128, "min_size": 80, "line_height": 0.92, "tracking": -1 },
  "signature": { "name": "Felipe Lenzi", "tagline": "IA aplicada a negócios" },
  "themes": {
    "claro": { "fundo": "paper", "texto": "ink", "apoio": "muted_on_paper", "fio": "rule_on_paper", "superficie": "lavender_soft", "reticula": "lavender" },
    "escuro": { "fundo": "charcoal", "texto": "text_on_charcoal", "apoio": "muted_on_charcoal", "fio": "rule_on_charcoal", "superficie": "rule_on_charcoal", "reticula": "halftone_on_charcoal" }
  },
  "rules": {
    "contrast": { "text_min": 4.5, "large_text_min": 3.0, "large_size": 24, "large_bold_size": 18.66, "halftone_max": 2.0 },
    "lime": { "max_element_area": 9000, "max_total_area": 18000, "max_shape_side": 240 },
    "footer": { "top": 1200, "bottom_margin": 40 },
    "clearance": 2,
    "repetition_window": 5
  }
}
